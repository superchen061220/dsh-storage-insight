{
  "name": "dsh-storage-insight",
  "version": "0.1.0",
  "description": "Storage Insight for DeepSeek Harness — see what dsh really occupies on this machine, and reclaim only rebuildable caches.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "storage",
    "disk-usage",
    "cleanup"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superchen061220/dsh-storage-insight.git"
  },
  "homepage": "https://github.com/superchen061220/dsh-storage-insight#readme",
  "bugs": {
    "url": "https://github.com/superchen061220/dsh-storage-insight/issues"
  },
  "scripts": {
    "test": "node test-host.mjs && node test-client.mjs"
  }
}
